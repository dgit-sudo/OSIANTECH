<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
const paragraphs = Array.isArray(course.detailParagraphs) && course.detailParagraphs.length
  ? course.detailParagraphs
  : [course.description || ''];
const outcomes = Array.isArray(course.outcomes) ? course.outcomes : [];
const syllabus = Array.isArray(course.syllabus) ? course.syllabus : [];
const toolsUsed = Array.isArray(course.toolsUsed) ? course.toolsUsed : [];
const careerRoles = Array.isArray(course.careerRoles) ? course.careerRoles : [];
const audience = Array.isArray(course.audience) ? course.audience : [];
const faqs = Array.isArray(course.faqs) ? course.faqs : [];
const feeValue = Number(course.displayFee || course.nonMetroFee || course.metroFee || 0);
%>

<!-- ===== HERO ===== -->
<section class="cd-hero">
  <div class="cd-hero-glow" aria-hidden="true"></div>
  <div class="container cd-hero-inner">
    <nav class="cd-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span>
      <a href="/courses">Courses</a><span>/</span>
      <a href="/courses?category=<%= encodeURIComponent(course.category || '') %>"><%= course.category || 'Course' %></a>
    </nav>

    <span class="cd-hero-kicker"><%= course.subject || course.category || 'Live Programme' %></span>
    <h1 class="cd-hero-title"><%= course.title %></h1>
    <p class="cd-hero-lede"><%= course.description %></p>

    <div class="cd-hero-facts">
      <div class="cd-fact"><span class="cd-fact-k">Duration</span><span class="cd-fact-v"><%= course.duration || 'Flexible' %></span></div>
      <div class="cd-fact"><span class="cd-fact-k">Format</span><span class="cd-fact-v">Live 1-on-1</span></div>
      <div class="cd-fact"><span class="cd-fact-k">Level</span><span class="cd-fact-v"><%= course.level || 'All levels' %></span></div>
      <div class="cd-fact"><span class="cd-fact-k">Certificate</span><span class="cd-fact-v"><%= course.certification || 'Osian Academy' %></span></div>
    </div>

    <div class="cd-hero-actions">
      <a href="/checkout/<%= course.id %>" class="btn btn-primary btn-lg" id="course-buy-now" data-course-id="<%= course.id %>">Enroll now</a>
      <a href="https://wa.me/919624284999" target="_blank" rel="noopener noreferrer" class="btn btn-outline-white btn-lg">Talk to an advisor</a>
    </div>
  </div>
</section>

<!-- ===== BODY ===== -->
<section class="cd-body">
  <div class="container cd-layout">

    <main class="cd-main">

      <!-- Overview -->
      <article class="cd-block" id="overview">
        <header class="cd-block-head">
          <span class="cd-eyebrow">Overview</span>
          <h2 class="cd-h2">What this course is about</h2>
        </header>
        <% paragraphs.forEach(function(p) { %>
        <p class="cd-prose"><%= p %></p>
        <% }); %>
      </article>

      <!-- What you'll be able to do -->
      <% if (outcomes.length) { %>
      <article class="cd-block" id="outcomes">
        <header class="cd-block-head">
          <span class="cd-eyebrow">By the end</span>
          <h2 class="cd-h2">What you&rsquo;ll be able to do</h2>
        </header>
        <ul class="cd-outcomes">
          <% outcomes.forEach(function(o) { %>
          <li><span class="cd-tick" aria-hidden="true">&#10003;</span><%= o %></li>
          <% }); %>
        </ul>
      </article>
      <% } %>

      <!-- Syllabus flowchart -->
      <% if (syllabus.length) { %>
      <article class="cd-block" id="syllabus">
        <header class="cd-block-head">
          <span class="cd-eyebrow">Syllabus</span>
          <h2 class="cd-h2">How the course flows</h2>
        </header>
        <ol class="cd-flow">
          <% syllabus.forEach(function(m, i) { %>
          <li class="cd-flow-step">
            <div class="cd-flow-marker">
              <span class="cd-flow-num"><%= m.step || (i + 1) %></span>
              <% if (i < syllabus.length - 1) { %><span class="cd-flow-rail" aria-hidden="true"></span><% } %>
            </div>
            <div class="cd-flow-card">
              <div class="cd-flow-top">
                <h3 class="cd-flow-name"><%= m.name %></h3>
                <% if (m.when) { %><span class="cd-flow-when"><%= m.when %></span><% } %>
              </div>
              <p class="cd-flow-focus"><%= m.focus %></p>
            </div>
          </li>
          <% }); %>
        </ol>
      </article>
      <% } %>

      <!-- Tools + Careers -->
      <div class="cd-split">
        <% if (toolsUsed.length) { %>
        <article class="cd-block cd-block-sm">
          <header class="cd-block-head"><span class="cd-eyebrow">Toolkit</span><h2 class="cd-h2">Tools you&rsquo;ll use</h2></header>
          <div class="cd-tools">
            <% toolsUsed.forEach(function(t) { %><span class="cd-tool"><%= t %></span><% }); %>
          </div>
        </article>
        <% } %>

        <% if (audience.length) { %>
        <article class="cd-block cd-block-sm">
          <header class="cd-block-head"><span class="cd-eyebrow">Fit</span><h2 class="cd-h2">Who it&rsquo;s for</h2></header>
          <ul class="cd-who">
            <% audience.forEach(function(a) { %><li><%= a %></li><% }); %>
          </ul>
        </article>
        <% } %>
      </div>

      <!-- Career outcomes -->
      <% if (careerRoles.length) { %>
      <article class="cd-block" id="careers">
        <header class="cd-block-head">
          <span class="cd-eyebrow">Where it leads</span>
          <h2 class="cd-h2">Roles this opens up</h2>
        </header>
        <div class="cd-roles">
          <% careerRoles.forEach(function(r) { %>
          <div class="cd-role">
            <h3 class="cd-role-title"><%= r.title %></h3>
            <span class="cd-role-pay"><%= r.salary %></span>
            <p class="cd-role-desc"><%= r.desc %></p>
          </div>
          <% }); %>
        </div>
      </article>
      <% } %>

      <!-- FAQ -->
      <% if (faqs.length) { %>
      <article class="cd-block" id="faq">
        <header class="cd-block-head">
          <span class="cd-eyebrow">Questions</span>
          <h2 class="cd-h2">Before you enroll</h2>
        </header>
        <div class="cd-faq">
          <% faqs.forEach(function(f, i) { %>
          <div class="cd-faq-item">
            <button class="cd-faq-q" aria-expanded="<%= i === 0 ? 'true' : 'false' %>" data-faq-toggle>
              <span><%= f.q %></span>
              <span class="cd-faq-chevron" aria-hidden="true">+</span>
            </button>
            <div class="cd-faq-a"><p><%= f.a %></p></div>
          </div>
          <% }); %>
        </div>
      </article>
      <% } %>
    </main>

    <!-- Sticky sidebar -->
    <aside class="cd-aside">
      <div class="cd-card">
        <div class="cd-price-row">
          <span class="cd-price-label">Course fee</span>
          <strong class="cd-price" id="course-fee-display" data-fee="<%= feeValue %>">INR <%= feeValue.toLocaleString('en-IN') %></strong>
          <span class="cd-price-note">Live one-on-one price for non-metro students</span>
        </div>
        <div class="cd-card-actions">
          <a href="/checkout/<%= course.id %>" class="btn btn-primary btn-block">Buy now</a>
          <a href="https://wa.me/919624284999" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block">Ask an advisor</a>
        </div>
        <ul class="cd-card-specs">
          <li><span>Duration</span><strong><%= course.duration || 'Flexible' %></strong></li>
          <li><span>Level</span><strong><%= course.level || 'All levels' %></strong></li>
          <li><span>Mode</span><strong>100% online, live</strong></li>
          <li><span>Sessions</span><strong>1-on-1 with a mentor</strong></li>
          <li><span>Prerequisite</span><strong><%= course.prerequisite || 'None' %></strong></li>
          <li><span>Certificate</span><strong><%= course.certification || 'Osian Academy' %></strong></li>
        </ul>
        <div class="cd-card-guarantee">
          <strong>Placement support included</strong>
          <p>Resume help, mock interviews and referrals through our hiring-partner network.</p>
        </div>
      </div>
    </aside>

  </div>
</section>

<script>
(function () {
  document.querySelectorAll('[data-faq-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    });
  });
})();
</script>

<script type="module" src="/js/course-detail-page.js?v=<%= assetVersion %>"></script>

<%- include('partials/footer') %>
