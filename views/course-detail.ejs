<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
const learnPoints = Array.isArray(course.keyPoints)
  ? course.keyPoints.filter(point => !/^pre[\s-]*requisite\s*:/i.test(point) && !/^certification\s*:/i.test(point))
  : [];
const prereqPoints = Array.isArray(course.keyPoints)
  ? course.keyPoints.filter(point => /^pre[\s-]*requisite\s*:/i.test(point))
  : [];
const certPoints = Array.isArray(course.keyPoints)
  ? course.keyPoints.filter(point => /^certification\s*:/i.test(point))
  : [];
const descriptionParagraphs = Array.isArray(course.detailParagraphs) ? course.detailParagraphs : [course.description || ''];
const heroBackground = course.image ? `background-image: linear-gradient(180deg, rgba(7, 10, 20, 0.88), rgba(7, 10, 20, 0.92)), url('${course.image}');` : '';
const heroLabel = course.category || 'Course Detail';
%>

<section class="course-detail-hero" style="<%= heroBackground %>">
  <div class="course-detail-hero-overlay"></div>
  <div class="container course-detail-hero-inner" data-animate="fade-up">
    <div class="course-detail-hero-label"><%= heroLabel %></div>
    <h1 class="course-detail-hero-title"><%= course.title %></h1>
    <p class="course-detail-hero-copy">A premium live one-on-one program designed to teach practical skills, build portfolio-ready projects, and get you career-ready faster.</p>

    <div class="course-detail-hero-meta">
      <span class="hero-chip"><strong><%= course.level || 'Professional' %></strong></span>
      <span class="hero-chip"><strong><%= course.duration || 'Flexible' %></strong></span>
      <span class="hero-chip"><strong>100% Online</strong></span>
      <span class="hero-chip"><strong>Placement Support</strong></span>
    </div>

    <div class="course-detail-hero-actions">
      <a href="/checkout/<%= course.id %>" class="btn btn-primary btn-lg" data-course-id="<%= course.id %>" id="course-buy-now">Enroll Now</a>
      <a href="/courses" class="btn btn-ghost btn-lg">Back to Courses</a>
    </div>
  </div>
</section>

<section class="course-detail-body page-course-detail" data-animate="fade-up">
  <div class="container">
    <div class="course-detail-grid">

      <main class="course-detail-main">
        <div class="detail-section detail-section-intro">
          <div class="detail-section-head">
            <span class="section-label">Course overview</span>
            <h2 class="section-title">Why this course matters</h2>
          </div>
          <% descriptionParagraphs.forEach(function(paragraph) { %>
          <p class="detail-copy"><%= paragraph %></p>
          <% }); %>
        </div>

        <% if (learnPoints.length) { %>
        <div class="detail-section detail-section-grid two-column-grid">
          <div>
            <h3>What you will learn</h3>
            <div class="detail-feature-grid">
              <% learnPoints.forEach(function(point) { %>
              <div class="detail-feature-card">
                <span class="feature-icon">✓</span>
                <p><%= point %></p>
              </div>
              <% }); %>
            </div>
          </div>
          <div>
            <h3>Course highlights</h3>
            <ul class="detail-highlight-list">
              <li>Live 1-on-1 mentorship</li>
              <li>Hands-on projects and real deliverables</li>
              <li>Certificate with placement assistance</li>
              <li>Flexible schedule and career-focused support</li>
            </ul>
          </div>
        </div>
        <% } %>

        <% if (course.contentSections && course.contentSections.length) { %>
        <div class="detail-section">
          <div class="detail-section-head">
            <span class="section-label">Curriculum</span>
            <h2 class="section-title">Structured learning path</h2>
          </div>
          <div class="detail-flowchart" data-animate="fade-up">
            <% course.contentSections.forEach(function(section, idx) { %>
            <div class="flow-step <%= idx === 0 ? 'flow-step-active' : '' %>">
              <span class="flow-step-number"><%= idx + 1 %></span>
              <strong><%= section.heading %></strong>
              <% if (section.bullets && section.bullets.length) { %>
              <ul>
                <% section.bullets.slice(0, 3).forEach(function(item) { %>
                <li><%= item %></li>
                <% }); %>
              </ul>
              <% } %>
            </div>
            <% if (idx < course.contentSections.length - 1) { %>
            <div class="flow-divider">→</div>
            <% } %>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="detail-section detail-section-grid two-column-grid">
          <div>
            <h3>Tools & technologies</h3>
            <div class="detail-tools-grid">
              <% course.toolsList.forEach(function(tool) { %>
              <span class="tool-pill"><%= tool %></span>
              <% }); %>
            </div>
          </div>
          <div>
            <h3>Career outcomes</h3>
            <div class="detail-outcome-grid">
              <% course.jobs.slice(0, 4).forEach(function(job) { %>
              <div class="outcome-card">
                <strong><%= job.title %></strong>
                <span><%= job.salary %></span>
                <p><%= job.desc %></p>
              </div>
              <% }); %>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <div class="detail-section-head">
            <span class="section-label">Roadmap</span>
            <h2 class="section-title">Skill progression map</h2>
          </div>
          <div class="detail-roadmap">
            <% course.roadmap.forEach(function(step) { %>
            <div class="roadmap-step">
              <div class="roadmap-step-circle"><%= step.step %></div>
              <div>
                <strong><%= step.phase %></strong>
                <p><%= step.desc %></p>
              </div>
            </div>
            <% }); %>
          </div>
        </div>

        <div class="detail-section detail-section-grid two-column-grid">
          <div>
            <h3>Who should enroll</h3>
            <ul class="who-list">
              <% course.whoShouldEnroll.forEach(function(item) { %>
              <li><span>✓</span> <%= item %></li>
              <% }); %>
            </ul>
          </div>
          <div>
            <h3>Prerequisites & certification</h3>
            <div class="detail-kp-grid">
              <div class="kp-card">
                <h4>Prerequisites</h4>
                <ul>
                  <% if (prereqPoints.length) { prereqPoints.forEach(function(point) { %>
                  <li><%= point.replace(/^pre[\s-]*requisite\s*:\s*/i, '') %></li>
                  <% }); } else { %>
                  <li>No prior knowledge required.</li>
                  <% } %>
                </ul>
              </div>
              <div class="kp-card">
                <h4>Certification</h4>
                <ul>
                  <% if (certPoints.length) { certPoints.forEach(function(point) { %>
                  <li><%= point.replace(/^certification\s*:\s*/i, '') %></li>
                  <% }); } else { %>
                  <li>Osian Academy completion certificate included.</li>
                  <% } %>
                  <li>Recognised by our hiring partners.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="detail-section">
          <div class="detail-section-head">
            <span class="section-label">Support</span>
            <h2 class="section-title">Frequently asked questions</h2>
          </div>
          <div class="detail-faq">
            <% course.enrichedFaqs.forEach(function(faq, idx) { %>
            <div class="faq-item">
              <button class="faq-toggle" aria-expanded="<%= idx === 0 ? 'true' : 'false' %>" data-faq-toggle>
                <span><%= faq.q %></span>
                <span>▼</span>
              </button>
              <div class="faq-body"><p><%= faq.a %></p></div>
            </div>
            <% }); %>
          </div>
        </div>
      </main>

      <aside class="course-detail-sidebar" data-animate="fade-left">
        <div class="sidebar-panel">
          <div class="sidebar-price-block">
            <span class="sidebar-label">Course fee</span>
            <strong class="sidebar-price" id="course-fee-display" data-fee="<%= Number(course.displayFee || course.nonMetroFee || course.metroFee || 0) %>">INR <%= Number(course.displayFee || course.nonMetroFee || course.metroFee || 0).toLocaleString('en-IN') %></strong>
            <span class="sidebar-note">Live one-on-one price for non-metro students</span>
          </div>
          <div class="sidebar-actions">
            <a href="/checkout/<%= course.id %>" class="btn btn-primary btn-block">Buy now</a>
            <a href="https://wa.me/919624284999" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-block">Ask an advisor</a>
          </div>
          <div class="sidebar-highlights">
            <h4>Course details</h4>
            <ul>
              <li><strong>Duration:</strong> <%= course.duration || 'Flexible' %></li>
              <li><strong>Level:</strong> <%= course.level || 'All levels' %></li>
              <li><strong>Mode:</strong> <%= course.snapshot.mode %></li>
              <li><strong>Sessions:</strong> <%= course.snapshot.sessions %></li>
              <li><strong>Support:</strong> <%= course.snapshot.support %></li>
              <li><strong>Certificate:</strong> <%= course.snapshot.cert %></li>
            </ul>
          </div>
          <div class="sidebar-note-card">
            <strong>Why choose this course?</strong>
            <p>Designed for learners who want fast applied outcomes, live mentoring, and a portfolio-ready path into professional roles.</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
(function () {
  document.querySelectorAll('[data-faq-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    });
  });
})();
</script>

<script type="module" src="/js/course-detail-page.js?v=<%= assetVersion %>"></script>

<%- include('partials/footer') %>
