<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
const safeSearchQuery = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
const safeActiveCategory = (typeof activeCategory !== 'undefined') ? activeCategory : 'All';
const isFiltered = safeActiveCategory !== 'All' || safeSearchQuery;
const catMeta = [
  { name: 'Programming & Software', icon: '💻', desc: 'Master languages, frameworks and software engineering tools used by industry-ready developers.' },
  { name: 'Design & Animation', icon: '🎨', desc: 'Build brand identities, motion graphics, UI/UX experiences and visual stories that stand out.' },
  { name: 'Networking, Hardware & Engineering', icon: '🔌', desc: 'Learn the systems, security and infrastructure that power modern enterprise IT.' },
  { name: 'Accounting, Finance & Office Skills', icon: '💼', desc: 'Gain practical finance, accounting and office automation skills for corporate careers.' },
  { name: 'Data, AI & Digital Marketing', icon: '📊', desc: 'Turn data into decisions and launch digital campaigns that deliver measurable results.' },
  { name: 'Kids Programs', icon: '⭐', desc: 'Spark early STEM learning with fun, practical coding, robotics and creative computing.' },
];
const catIconMap = {};
catMeta.forEach(function(c) { catIconMap[c.name] = c.icon; });
%>

<section class="courses-hero page-hero courses-hero" data-animate="fade-up">
  <div class="container">
    <div class="hero-copy">
      <div class="section-tag">Course Catalogue</div>
      <h1 class="page-hero-title">Browse the most complete<br><span>career-led IT course library</span></h1>
      <p class="page-hero-sub">Live, instructor-led courses across programming, design, networking, finance, data and kids learning. Every course is built to help you learn with projects, get certified, and move toward better career outcomes.</p>
      <div class="course-hero-meta">
        <span class="meta-badge"><%= typeof totalCourses !== 'undefined' ? totalCourses : (Array.isArray(courses) ? courses.length : 0) %> Courses</span>
        <span class="meta-badge">6 Career Tracks</span>
        <span class="meta-badge">100% Live Sessions</span>
        <span class="meta-badge">Placement Support</span>
      </div>
    </div>
  </div>
</section>

<section class="courses-toolbar page-courses" data-animate="fade-up">
  <div class="container">
    <div class="courses-toolbar-inner">
      <form class="courses-search-row" action="/courses" method="GET" data-courses-search-form>
        <div class="courses-search-field">
          <svg class="courses-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="course-search" class="courses-search-input" type="search" name="q" value="<%= safeSearchQuery %>" placeholder="Search courses, topics or tools…" data-courses-search-input autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
      <div class="filter-bar">
        <a href="/courses" class="filter-btn <%= (!safeSearchQuery && safeActiveCategory === 'All') ? 'active' : '' %>">All Courses</a>
        <% if (typeof categories !== 'undefined') { categories.forEach(function(cat) { %>
          <a href="/courses?category=<%= encodeURIComponent(cat) %>" class="filter-btn <%= (safeActiveCategory === cat) ? 'active' : '' %>">
            <% if (catIconMap[cat]) { %><span class="filter-btn-icon"><%= catIconMap[cat] %></span><% } %><%= cat %>
          </a>
        <% }); } %>
      </div>
    </div>
  </div>
</section>

<% if (!isFiltered) { %>

<section class="courses-job-section page-courses" data-animate="fade-up">
  <div class="container">
    <div class="spr-head">
      <p class="section-label">Featured Career Tracks</p>
      <h2 class="spr-title">Explore the biggest skill paths employers are hiring for</h2>
      <p class="spr-sub">Choose the learning path that fits your goal — from software engineering and data analytics to creative design, networking and finance.</p>
    </div>
    <div class="courses-job-grid">
      <a href="/courses?category=Programming+%26+Software" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">⚡</div><span class="spr-track-num">01</span></div>
        <h3>Programming & Software</h3>
        <p>From full-stack development to databases and system automation — build the applications powering modern businesses.</p>
        <span class="spr-link">Browse track →</span>
      </a>
      <a href="/courses?category=Data%2C+AI+%26+Digital+Marketing" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">📈</div><span class="spr-track-num">02</span></div>
        <h3>Data, AI & Marketing</h3>
        <p>Analyse data, build machine learning models and launch results-driven digital campaigns for business growth.</p>
        <span class="spr-link">Browse track →</span>
      </a>
      <a href="/courses?category=Design+%26+Animation" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">🎨</div><span class="spr-track-num">03</span></div>
        <h3>Design & Animation</h3>
        <p>Create high-impact brand experiences, animations and product interfaces using industry-standard creative tools.</p>
        <span class="spr-link">Browse track →</span>
      </a>
      <a href="/courses?category=Networking%2C+Hardware+%26+Engineering" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">🔌</div><span class="spr-track-num">04</span></div>
        <h3>Networking & Engineering</h3>
        <p>Learn networking, systems and hardware fundamentals that keep enterprise infrastructure secure and reliable.</p>
        <span class="spr-link">Browse track →</span>
      </a>
      <a href="/courses?category=Accounting%2C+Finance+%26+Office+Skills" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">💰</div><span class="spr-track-num">05</span></div>
        <h3>Accounting & Finance</h3>
        <p>Develop practical accounting, taxation and business software skills for finance teams and admin roles.</p>
        <span class="spr-link">Browse track →</span>
      </a>
      <a href="/courses?category=Kids+Programs" class="spr-card">
        <div class="spr-card-top"><div class="spr-icon">⭐</div><span class="spr-track-num">06</span></div>
        <h3>Kids Programs</h3>
        <p>Introduce young learners to STEM, coding and creative computing through fun, guided projects.</p>
        <span class="spr-link">Browse track →</span>
      </a>
    </div>
  </div>
</section>

<% catMeta.forEach(function(cat, catIdx) { %>
<%
  const catCourses = (typeof courses !== 'undefined' ? courses : []).filter(c => c.category === cat.name).slice(0, 8);
  if (!catCourses.length) return;
%>
<section class="section courses-category-section<%= catIdx % 2 !== 0 ? ' section-alt' : '' %> page-courses" data-animate="fade-up">
  <div class="container">
    <div class="courses-cat-header">
      <div class="courses-cat-icon-wrap"><span class="courses-cat-icon"><%= cat.icon %></span></div>
      <div class="courses-cat-info">
        <p class="section-label"><%= cat.name %></p>
        <h2 class="section-title"><%= cat.name %></h2>
        <p class="section-sub"><%= cat.desc %></p>
      </div>
      <a href="/courses?category=<%= encodeURIComponent(cat.name) %>" class="btn btn-ghost courses-cat-view-all">View all →</a>
    </div>
    <div class="courses-grid" data-courses-grid>
      <% catCourses.forEach(function(course) { %>
      <a href="/courses/<%= course.id %>" class="course-card-link" data-course-card data-course-title="<%= course.title %>">
        <article class="course-card">
          <div class="course-img course-img-<%= (course.id % 9) + 1 %> <%= course.image ? 'has-course-image' : '' %>"<% if (course.image) { %> style="--course-image: url('<%= course.image %>');"<% } %>>
            <div class="course-img-overlay">
              <div class="course-category-tag"><%= course.category || cat.name %></div>
              <% if (!course.image) { %><span class="course-img-cat-icon"><%= cat.icon %></span><% } %>
            </div>
          </div>
          <div class="course-body">
            <div class="course-meta">
              <span class="meta-item"><%= course.level || 'Professional' %></span>
              <span class="meta-item"><%= course.duration || 'Flexible pace' %></span>
            </div>
            <h3 class="course-title"><%= course.title %></h3>
            <p class="course-description"><%= course.description %></p>
            <div class="course-footer">
              <span class="course-meta-pill">Training track</span>
              <span class="course-arrow">View Details →</span>
            </div>
          </div>
        </article>
      </a>
      <% }); %>
    </div>
    <div class="courses-cat-footer">
      <a href="/courses?category=<%= encodeURIComponent(cat.name) %>" class="btn btn-ghost">Browse all <%= cat.name %> courses →</a>
    </div>
  </div>
</section>
<% }); %>

<% } else { %>

<section class="section courses-results-section page-courses" data-animate="fade-up">
  <div class="container">
    <div class="courses-results-header">
      <div class="courses-results-meta">
        <p class="section-label">Filtered Results</p>
        <h2 class="section-title"><% if (safeSearchQuery) { %>Results for "<%= safeSearchQuery %>"<% } else { %><%= safeActiveCategory %><% } %></h2>
        <p class="section-sub">Showing <strong><%= typeof shownCourses !== 'undefined' ? shownCourses : (Array.isArray(courses) ? courses.length : 0) %></strong> of <strong><%= typeof totalCourses !== 'undefined' ? totalCourses : (Array.isArray(courses) ? courses.length : 0) %></strong> courses<% if (safeActiveCategory !== 'All') { %> in <em><%= safeActiveCategory %></em><% } %></p>
      </div>
      <a href="/courses" class="btn btn-ghost">Clear filters ×</a>
    </div>

    <% if (typeof courses !== 'undefined' && courses.length) { %>
    <div class="courses-grid" data-courses-grid>
      <% courses.forEach(function(course) { %>
      <a href="/courses/<%= course.id %>" class="course-card-link" data-course-card data-course-title="<%= course.title %>">
        <article class="course-card">
          <div class="course-img course-img-<%= (course.id % 9) + 1 %> <%= course.image ? 'has-course-image' : '' %>"<% if (course.image) { %> style="--course-image: url('<%= course.image %>');"<% } %>>
            <div class="course-img-overlay">
              <div class="course-category-tag"><%= course.category || 'General' %></div>
            </div>
          </div>
          <div class="course-body">
            <div class="course-meta">
              <span class="meta-item"><%= course.level || 'Professional' %></span>
              <span class="meta-item"><%= course.duration || 'Flexible pace' %></span>
            </div>
            <h3 class="course-title"><%= course.title %></h3>
            <p class="course-description"><%= course.description %></p>
            <div class="course-footer">
              <span class="course-meta-pill">View course</span>
              <span class="course-arrow">View Details →</span>
            </div>
          </div>
        </article>
      </a>
      <% }); %>
    </div>
    <div class="course-empty" data-courses-empty style="display:none;">
      <h3>No matching courses found</h3>
      <p>Try a different keyword or <a href="/courses" style="color:#f97316">view all courses</a>.</p>
    </div>
    <% } else { %>
    <div class="course-empty">
      <h3>No courses found</h3>
      <p><a href="/courses" style="color:#f97316">Clear filters and view all courses →</a></p>
    </div>
    <% } %>
  </div>
</section>

<% } %>

<%- include('partials/footer') %>
