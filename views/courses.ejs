<%- include('partials/head') %>
<%- include('partials/navbar') %>

<%
const safeSearchQuery = (typeof searchQuery !== 'undefined' && searchQuery) ? searchQuery : '';
const safeActiveCategory = (typeof activeCategory !== 'undefined') ? activeCategory : 'All';
const isFiltered = safeActiveCategory !== 'All' || safeSearchQuery;
const allShownCourses = (typeof courses !== 'undefined' && Array.isArray(courses)) ? courses : [];
const totalCourseCount = (typeof totalCourses !== 'undefined') ? totalCourses : allShownCourses.length;
const catMeta = [
  { name: 'Programming & Software', short: 'Programming', icon: '💻', accent: 'ct-1', tag: 'Build & Ship', desc: 'Master languages, frameworks and software engineering tools used by industry-ready developers.' },
  { name: 'Data, AI & Digital Marketing', short: 'Data & AI', icon: '📊', accent: 'ct-2', tag: 'Analyse & Grow', desc: 'Turn data into decisions and launch digital campaigns that deliver measurable results.' },
  { name: 'Design & Animation', short: 'Design', icon: '🎨', accent: 'ct-3', tag: 'Create & Craft', desc: 'Build brand identities, motion graphics, UI/UX experiences and visual stories that stand out.' },
  { name: 'Networking, Hardware & Engineering', short: 'Networking', icon: '🔌', accent: 'ct-4', tag: 'Secure & Scale', desc: 'Learn the systems, security and infrastructure that power modern enterprise IT.' },
  { name: 'Accounting, Finance & Office Skills', short: 'Finance', icon: '💼', accent: 'ct-5', tag: 'Manage & Report', desc: 'Gain practical finance, accounting and office automation skills for corporate careers.' },
  { name: 'Kids Programs', short: 'Kids', icon: '⭐', accent: 'ct-6', tag: 'Explore & Play', desc: 'Spark early STEM learning with fun, practical coding, robotics and creative computing.' },
];
const catIconMap = {};
const catShortMap = {};
catMeta.forEach(function(c) { catIconMap[c.name] = c.icon; catShortMap[c.name] = c.short; });
%>

<!-- ===== CINEMATIC HERO ===== -->
<section class="courses-hero-cinematic" id="courses-hero">
  <div class="ch-aurora" aria-hidden="true">
    <span class="ch-blob ch-blob-1"></span>
    <span class="ch-blob ch-blob-2"></span>
    <span class="ch-blob ch-blob-3"></span>
  </div>
  <div class="ch-grid-overlay" aria-hidden="true"></div>

  <div class="container ch-inner">
    <h1 class="ch-headline" data-hero-headline>
      <span class="hero-line">The most complete</span>
      <span class="hero-line hero-line-accent">career-led course library</span>
    </h1>

    <p class="ch-sub" data-reveal="fade-up" data-reveal-delay="1">
      Live 1-on-1 courses across programming, design, networking, finance, data and kids
      learning. Every programme is built around real projects, recognised certification, and
      100% placement support.
    </p>

    <!-- Compact Embedded Search Bar -->
    <form class="hero-search-form" action="/courses" method="GET" data-courses-search-form data-reveal="fade-up" data-reveal-delay="2">
      <div class="hero-search-field">
        <svg class="hero-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ff7a00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="course-search" class="courses-search-input" type="search" name="q" value="<%= safeSearchQuery %>" placeholder="Search courses, topics or tools (e.g. Python, React, UI/UX)..." data-courses-search-input autocomplete="off" />
        <button type="submit" class="hero-search-btn">Search</button>
      </div>
    </form>

    <div class="ch-stats" data-reveal="fade-up" data-reveal-delay="3" data-reveal-stagger>
      <div class="ch-stat-pill">
        <span class="ch-stat-num stat-value"><%= totalCourseCount %>+</span>
        <span class="ch-stat-lbl">Courses</span>
      </div>
      <div class="ch-stat-pill">
        <span class="ch-stat-num stat-value">6</span>
        <span class="ch-stat-lbl">Career Tracks</span>
      </div>
      <div class="ch-stat-pill">
        <span class="ch-stat-num stat-value">100%</span>
        <span class="ch-stat-lbl">Live Sessions</span>
      </div>
      <div class="ch-stat-pill">
        <span class="ch-stat-num stat-value">95%</span>
        <span class="ch-stat-lbl">Placement</span>
      </div>
    </div>
  </div>
</section>

<!-- ===== SKILLS TICKER ===== -->
<div class="courses-ticker" aria-hidden="true">
  <div class="courses-ticker-track">
    <% const skillTags = ['Full-Stack Development', 'Python', 'Data Science', 'UI/UX Design', 'Cloud & DevOps', 'Cybersecurity', 'Digital Marketing', 'Tally & GST', '3D & Animation', 'Machine Learning', 'Networking', 'Robotics for Kids']; %>
    <% [1, 2].forEach(function () { %>
      <% skillTags.forEach(function (tag) { %>
        <span><%= tag %></span><span class="dot">&#9679;</span>
      <% }); %>
    <% }); %>
  </div>
</div>

<% if (!isFiltered) { %>



<!-- ===== PER-CATEGORY COURSE BLOCKS ===== -->
<% catMeta.forEach(function(cat, catIdx) { %>
<%
  const catCoursesAll = allShownCourses.filter(function(c){ return c.category === cat.name; });
  if (!catCoursesAll.length) return;
  const catCourses = catCoursesAll.slice(0, 6);
%>
<section class="courses-category-section section<%= catIdx % 2 !== 0 ? ' section-alt' : '' %>">
  <div class="container">
    <div class="courses-cat-header" data-reveal="fade-up">
      <div class="courses-cat-icon-wrap <%= cat.accent %>"><span class="courses-cat-icon"><%= cat.icon %></span></div>
      <div class="courses-cat-info">
        <p class="section-label"><%= cat.tag %> · <%= catCoursesAll.length %> course<%= catCoursesAll.length === 1 ? '' : 's' %></p>
        <h2 class="courses-cat-title"><%= cat.name %></h2>
        <p class="courses-cat-sub"><%= cat.desc %></p>
      </div>
      <a href="/courses?category=<%= encodeURIComponent(cat.name) %>" class="btn btn-ghost courses-cat-view-all" data-magnetic>View all →</a>
    </div>
    <div class="courses-grid" data-courses-grid data-reveal="fade-up" data-reveal-delay="1" data-reveal-stagger>
      <% catCourses.forEach(function(course) { %>
      <a href="/courses/<%= course.id %>" class="course-card-link" data-course-card data-course-title="<%= course.title %>">
        <article class="course-card" data-tilt data-tilt-strength="4">
          <div class="course-img course-img-<%= (course.id % 9) + 1 %> <%= course.image ? 'has-course-image' : '' %>"<% if (course.image) { %> style="--course-image: url('<%= course.image %>');"<% } %>>
            <div class="course-img-overlay">
              <div class="course-category-tag"><%= course.category || cat.name %></div>
              <% if (!course.image) { %><span class="course-img-cat-icon"><%= cat.icon %></span><% } %>
            </div>
          </div>
          <div class="course-body">
            <div class="course-meta">
              <span class="meta-item"><%= course.level || 'Professional' %></span>
              <span class="meta-item"><%= course.duration || 'Flexible pace' %></span>
            </div>
            <h3 class="course-title"><%= course.title %></h3>
            <p class="course-description"><%= course.cardLine || course.description %></p>
            <div class="course-footer">
              <span class="course-meta-pill">Live 1-on-1</span>
              <span class="course-arrow">View Details →</span>
            </div>
          </div>
        </article>
      </a>
      <% }); %>
    </div>
    <% if (catCoursesAll.length > catCourses.length) { %>
    <div class="courses-cat-footer" data-reveal="fade-up">
      <a href="/courses?category=<%= encodeURIComponent(cat.name) %>" class="btn btn-ghost" data-magnetic>Browse all <%= catCoursesAll.length %> <%= cat.name %> courses →</a>
    </div>
    <% } %>
  </div>
</section>
<% }); %>

<!-- ===== CTA ===== -->
<section class="courses-cta">
  <div class="container">
    <div class="courses-cta-inner" data-reveal="fade-up">
      <p class="section-label courses-cta-label">Not sure where to start?</p>
      <h2 class="courses-cta-title">Talk to a mentor and find your track</h2>
      <p class="courses-cta-sub">Create a free account and our team will help you pick the right programme for your goals — then match you with a dedicated 1-on-1 instructor.</p>
      <div class="courses-cta-actions">
        <a href="/auth?mode=signup" class="btn btn-white btn-lg" data-magnetic data-auth-guest>Create Free Account</a>
        <a href="/dashboard" class="btn btn-white btn-lg" data-magnetic data-auth-user hidden>Go to Dashboard</a>
        <a href="/contact" class="btn btn-outline-white btn-lg" data-magnetic>Contact Us</a>
      </div>
    </div>
  </div>
</section>

<% } else { %>

<!-- ===== FILTERED RESULTS ===== -->
<section class="courses-results-section section">
  <div class="container">
    <div class="courses-results-header" data-reveal="fade-up">
      <div class="courses-results-meta">
        <p class="section-label">Filtered Results</p>
        <h2 class="courses-section-title"><% if (safeSearchQuery) { %>Results for "<%= safeSearchQuery %>"<% } else { %><%= safeActiveCategory %><% } %></h2>
        <p class="courses-results-sub">Showing <strong><%= typeof shownCourses !== 'undefined' ? shownCourses : allShownCourses.length %></strong> of <strong><%= totalCourseCount %></strong> courses<% if (safeActiveCategory !== 'All') { %> in <em><%= safeActiveCategory %></em><% } %></p>
      </div>
      <a href="/courses" class="btn btn-ghost" data-magnetic>Clear filters ×</a>
    </div>

    <% if (allShownCourses.length) { %>
    <div class="courses-grid" data-courses-grid data-reveal="fade-up" data-reveal-delay="1" data-reveal-stagger>
      <% allShownCourses.forEach(function(course) { %>
      <a href="/courses/<%= course.id %>" class="course-card-link" data-course-card data-course-title="<%= course.title %>">
        <article class="course-card" data-tilt data-tilt-strength="4">
          <div class="course-img course-img-<%= (course.id % 9) + 1 %> <%= course.image ? 'has-course-image' : '' %>"<% if (course.image) { %> style="--course-image: url('<%= course.image %>');"<% } %>>
            <div class="course-img-overlay">
              <div class="course-category-tag"><%= course.category || 'General' %></div>
              <% if (!course.image && catIconMap[course.category]) { %><span class="course-img-cat-icon"><%= catIconMap[course.category] %></span><% } %>
            </div>
          </div>
          <div class="course-body">
            <div class="course-meta">
              <span class="meta-item"><%= course.level || 'Professional' %></span>
              <span class="meta-item"><%= course.duration || 'Flexible pace' %></span>
            </div>
            <h3 class="course-title"><%= course.title %></h3>
            <p class="course-description"><%= course.cardLine || course.description %></p>
            <div class="course-footer">
              <span class="course-meta-pill">Live 1-on-1</span>
              <span class="course-arrow">View Details →</span>
            </div>
          </div>
        </article>
      </a>
      <% }); %>
    </div>
    <div class="course-empty" data-courses-empty style="display:none;">
      <h3>No matching courses found</h3>
      <p>Try a different keyword or <a href="/courses">view all courses</a>.</p>
    </div>
    <% } else { %>
    <div class="course-empty">
      <h3>No courses found</h3>
      <p><a href="/courses">Clear filters and view all courses →</a></p>
    </div>
    <% } %>
  </div>
</section>

<% } %>

<script src="/js/courses-cinematic.js?v=<%= assetVersion %>"></script>

<%- include('partials/footer') %>
