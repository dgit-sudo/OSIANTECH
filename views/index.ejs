<!-- ===== 7. FEATURED COURSES (Live Database Loop) ===== -->
<section class="s-courses-catalog" id="courses">
  <div class="container">
    <div class="catalog-header-row" data-reveal="fade-up">
      <div>
        <span class="section-tag-pill">Live Catalog</span>
        <h2 class="section-title-large">Featured Programmes</h2>
      </div>
      <a href="/courses" class="btn-brand-ghost">View All Courses &rarr;</a>
    </div>

    <% if (featuredCourses && featuredCourses.length) { %>
    <div class="catalog-carousel-wrapper" data-catalog-carousel data-reveal="fade-up" data-reveal-delay="1">
      <button type="button" class="catalog-nav-btn catalog-nav-prev" data-carousel-prev aria-label="Previous">&#8249;</button>
      <div class="catalog-viewport">
        <div class="catalog-track" data-carousel-track>
          <% featuredCourses.forEach(function(course) { %>
          <div class="catalog-slide">
            <a href="/courses/<%= course.id %>" class="modern-course-card-link" data-course-card data-course-title="<%= course.title %>">
              <article class="modern-course-card">
                <div class="modern-course-thumb course-img-<%= (course.id % 9) + 1 %> <%= course.image ? 'has-course-image' : '' %>"<% if (course.image) { %> style="--course-image: url('<%= course.image %>'); background-image: url('<%= course.image %>');"<% } %>>
                  <div class="modern-course-overlay">
                    <span class="modern-category-tag"><%= course.category || 'Professional' %></span>
                  </div>
                </div>
                <div class="modern-course-body">
                  <div class="modern-course-meta">
                    <span class="modern-meta-item"><%= course.level || 'All Levels' %></span>
                    <span class="modern-meta-item"><%= course.duration || 'Flexible' %></span>
                  </div>
                  <h3 class="modern-course-title"><%= course.title %></h3>
                  <p class="modern-course-desc"><%= course.cardLine || course.description %></p>
                  <div class="modern-course-footer">
                    <span class="modern-pill-live">Live 1-on-1</span>
                    <span class="modern-course-arrow">View Curriculum &rarr;</span>
                  </div>
                </div>
              </article>
            </a>
          </div>
          <% }); %>
        </div>
      </div>
      <button type="button" class="catalog-nav-btn catalog-nav-next" data-carousel-next aria-label="Next">&#8250;</button>
    </div>
    <% } else { %>
    <div style="text-align: center; padding: 60px 20px; background: var(--bg-surface-1); border-radius: 20px; border: 1px solid var(--border);">
      <h3 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 8px;">Explore All Programmes</h3>
      <p style="color: var(--text-secondary); margin-bottom: 20px;">Browse our complete catalog of industry tracks.</p>
      <a href="/courses" class="btn-brand-primary">Open Courses Page &rarr;</a>
    </div>
    <% } %>
  </div>
</section>

