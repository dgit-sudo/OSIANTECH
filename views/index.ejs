<!-- ===== 3. SKILLS TICKER ===== -->
<div class="skills-ticker-wrap" aria-hidden="true">
  <div class="skills-ticker-track">
    <% const skillTags = ['Programming', 'Cloud Computing', 'Digital Marketing', 'Artificial Intelligence', 'Data Science', 'Cybersecurity', 'Web Development', 'UI/UX Design', 'Networking', 'Finance & Tally']; %>
    <% [1, 2].forEach(function () { %>
      <% skillTags.forEach(function (tag) { %>
        <span><%= tag %></span><span class="dot">&#9679;</span>
      <% }); %>
    <% }); %>
  </div>
</div>

<!-- ===== 4. STATS BAR ===== -->
<section class="s-stats-bar">
  <div class="container">
    <div class="stats-grid-4" data-reveal="fade-up">
